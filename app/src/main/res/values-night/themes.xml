<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Team10_MAPD711_ProjectMilestone2" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary app colors -->
        <item name="colorPrimary">@color/pink</item>
        <item name="colorPrimaryVariant">@color/pink_complimentary</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary app colors -->
        <item name="colorSecondary">@color/pink_complimentary</item>
        <item name="colorSecondaryVariant">@color/pink</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background and surface colors -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- Status and navigation bar colors -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/pink_complimentary</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/white</item>
    </style>
</resources>